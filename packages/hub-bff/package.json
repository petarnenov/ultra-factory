{
	"name": "@aoagents/hub-bff",
	"version": "0.1.0",
	"private": true,
	"description": "Web BFF for the AO hub on Railway: serves the web SPA, owns the operator login, and (from RW-2.4.2) proxies to daemons",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"start": "node src/main.ts",
		"hash-password": "node scripts/hash-password.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"@types/supertest": "7.2.1",
		"supertest": "7.3.1",
		"typescript": "5.9.3",
		"vitest": "4.1.12"
	},
	"license": "MIT"
}
