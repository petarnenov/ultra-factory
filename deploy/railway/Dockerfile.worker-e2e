ARG AO_WORKER_IMAGE=ao-worker:rw-e2e
FROM ${AO_WORKER_IMAGE}
USER root
RUN git config --system --add safe.directory /fixtures/e2e-fixture.git
# Baked in, not bind-mounted: compose talks to the host daemon, which
# cannot resolve a fixture path that exists only inside the job container.
COPY --chown=10001:10001 deploy/railway/e2e-fixture.git /fixtures/e2e-fixture.git
COPY --chown=10001:10001 cloud/test/fake-claude.sh /usr/local/bin/claude
RUN chmod 0755 /usr/local/bin/claude
USER 10001:10001
