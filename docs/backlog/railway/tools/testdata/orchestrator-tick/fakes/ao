#!/usr/bin/env bash
# Fake `ao` for orchestrator-tick-test.sh. It serves files from TICK_FIXTURE
# and records every `ao send` in $TICK_SENT.
set -euo pipefail
f="$TICK_FIXTURE"
case "$1 ${2:-}" in
"status --json") cat "$f/${TICK_STATUS:-status.json}" ;;
"orchestrator ls") cat "$f/${TICK_ORCHESTRATORS:-orchestrators.json}" ;;
"session get") cat "$f/${TICK_SESSION:-session-idle.txt}" ;;
"session ls")
	host="$4"
	if [[ "${5:-}" == --json ]]; then cat "$f/sessions-$host.json"; else cat "$f/sessions-$host.txt"; fi
	;;
send*) printf '%s\n' "$*" >>"$TICK_SENT" ;;
*)
	echo "fake ao: unexpected: $*" >&2
	exit 1
	;;
esac
